# YNAB authentication
YNAB_AUTH_MODE="oauth"
YNAB_ACCESS_TOKEN=""
YNAB_PLAN_ID="last-used"

# OAuth application
YNAB_OAUTH_CLIENT_ID=""
YNAB_OAUTH_CLIENT_SECRET=""
YNAB_OAUTH_REDIRECT_URI="http://localhost:8765/callback"
YNAB_OAUTH_SCOPE="read-only"
YNAB_OAUTH_TOKEN_PATH=".ynab-oauth-token.json"

# Optional 1Password lookup when YNAB_AUTH_MODE="onepassword"
OP_SERVICE_ACCOUNT_TOKEN=""
OP_VAULT_NAME=""
OP_ITEM_NAME=""

# Optional notification integration
DISCORD_ENABLED=false
DISCORD_TARGET=""

# Runtime
POLL_INTERVAL_MINUTES=15
LOG_LEVEL="INFO"

# SQLite default; use an async SQLAlchemy URL for another database
DATABASE_URL="sqlite+aiosqlite:///ynab_agent.db"
DATABASE_PATH="ynab_agent.db"
